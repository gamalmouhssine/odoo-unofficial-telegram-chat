<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_telegram_client" model="ir.actions.client">
        <field name="name">Unofficial Telegram</field>
        <field name="tag">telegram_personal_client.client</field>
        <field name="path">telegram-client</field>
    </record>

    <menuitem id="menu_telegram_root" name="Unofficial Telegram" sequence="8"
              action="action_telegram_client" groups="group_telegram_user"
              web_icon="telegram_personal_client,static/description/icon.png"/>

    <menuitem id="menu_telegram_chats" name="Chats" parent="menu_telegram_root"
              action="action_telegram_client" sequence="1"/>

    <menuitem id="menu_telegram_configuration" name="Configuration" parent="menu_telegram_root"
              sequence="100" groups="group_telegram_manager"/>

    <menuitem id="menu_telegram_settings" name="Settings" parent="menu_telegram_configuration"
              action="action_telegram_settings" sequence="0" groups="base.group_system"/>

    <menuitem id="menu_telegram_accounts" name="Accounts" parent="menu_telegram_configuration"
              action="action_telegram_account" sequence="10"/>
</odoo>
