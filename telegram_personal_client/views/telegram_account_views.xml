<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Administrators' overview: connection status only, never conversations. -->
    <record id="telegram_account_view_list" model="ir.ui.view">
        <field name="name">telegram.account.list</field>
        <field name="model">telegram.account</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="user_id" widget="many2one_avatar"/>
                <field name="tg_name"/>
                <field name="tg_username"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'connected'"
                       decoration-muted="state == 'disconnected'"
                       decoration-warning="state not in ('connected', 'disconnected')"/>
                <field name="connected_since"/>
                <field name="last_error" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="telegram_account_view_form" model="ir.ui.view">
        <field name="name">telegram.account.form</field>
        <field name="model">telegram.account</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <header>
                    <button name="action_force_disconnect" type="object" string="Force Disconnect"
                            groups="telegram_personal_client.group_telegram_manager"
                            invisible="state == 'disconnected'"
                            confirm="This logs the user's Telegram account out of Odoo and deletes the chats cached in Odoo. Their messages stay in Telegram. Continue?"/>
                    <field name="state" widget="statusbar" statusbar_visible="disconnected,connected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="user_id" widget="many2one_avatar"/></h1>
                    </div>
                    <group>
                        <group string="Telegram">
                            <field name="tg_name"/>
                            <field name="tg_username"/>
                            <field name="phone_masked"/>
                        </group>
                        <group string="Connection">
                            <field name="connected_since"/>
                            <field name="last_error"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="telegram_account_view_search" model="ir.ui.view">
        <field name="name">telegram.account.search</field>
        <field name="model">telegram.account</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="tg_username"/>
                <filter name="filter_connected" string="Connected" domain="[('state', '=', 'connected')]"/>
                <filter name="filter_problem" string="Needs Attention" domain="[('last_error', '!=', False)]"/>
                <separator/>
                <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_by_company" string="Company" context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company"/>
            </search>
        </field>
    </record>

    <record id="action_telegram_account" model="ir.actions.act_window">
        <field name="name">Telegram Accounts</field>
        <field name="res_model">telegram.account</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No Telegram account connected yet</p>
            <p>Users connect their own account from the Unofficial Telegram app. This list only shows connection status.</p>
        </field>
    </record>
</odoo>
