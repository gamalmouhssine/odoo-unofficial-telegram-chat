<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="telegram_personal_client.TelegramApp">
        <div class="o_telegram_app d-flex h-100 overflow-hidden" t-att-class="{'o_telegram_has_chat': selectedChat}">
            <t t-if="state.loading">
                <div class="flex-grow-1 d-flex align-items-center justify-content-center">
                    <i class="fa fa-circle-o-notch fa-spin fa-2x text-muted" role="img" aria-label="Loading"/>
                </div>
            </t>

            <t t-elif="!state.status.configured">
                <div class="flex-grow-1 d-flex align-items-center justify-content-center p-4">
                    <div class="alert alert-warning o_telegram_notice" role="status">
                        The Telegram API credentials are not configured yet.
                        <t t-if="state.status.is_admin">Set them in Unofficial Telegram › Configuration › Settings.</t>
                        <t t-else="">Please ask your administrator to set them up.</t>
                    </div>
                </div>
            </t>

            <t t-elif="connected">
                <aside class="o_telegram_sidebar d-flex flex-column border-end">
                    <div class="d-flex align-items-center gap-2 px-3 py-2 border-bottom">
                        <div class="flex-grow-1 text-truncate">
                            <div class="fw-bold text-truncate" t-out="state.status.tg_name or state.status.tg_username"/>
                            <div class="small text-muted">Unofficial Telegram client</div>
                        </div>
                        <button class="btn btn-sm btn-light" title="New chat" aria-label="New chat"
                                t-on-click="() => (state.showContacts = true)">
                            <i class="fa fa-pencil-square-o"/>
                        </button>
                        <button class="btn btn-sm btn-light" title="Disconnect" aria-label="Disconnect"
                                t-att-disabled="state.status.pending" t-on-click="confirmDisconnect">
                            <i class="fa fa-sign-out"/>
                        </button>
                    </div>
                    <t t-if="state.showContacts">
                        <ContactPanel onOpen.bind="openContact" onClose="() => (state.showContacts = false)"
                                      openingId="state.openingContactId"/>
                    </t>
                    <t t-else="">
                        <div class="p-2 border-bottom">
                            <input type="search" class="form-control" placeholder="Search chats" aria-label="Search chats"
                                   t-model="state.search"/>
                        </div>
                        <div t-if="!state.chatsReady or (!state.chats.length and !state.search)" class="p-4 text-center text-muted">
                            <i class="fa fa-circle-o-notch fa-spin me-1" aria-hidden="true"/>Synchronizing your chats…
                        </div>
                        <ChatList t-else="" chats="visibleChats" selectedId="state.selectedChatId" onSelect.bind="selectChat"/>
                    </t>
                </aside>
                <main class="o_telegram_main flex-grow-1 d-flex flex-column overflow-hidden">
                    <div t-if="state.status.last_error" class="alert alert-warning rounded-0 mb-0" role="status"
                         t-out="state.status.last_error"/>
                    <Conversation t-if="selectedChat and selectedEntry" chat="selectedChat" entry="selectedEntry"
                                  onSend.bind="send" onLoadOlder.bind="loadOlder" onRetry.bind="retry" onBack.bind="backToList"/>
                    <div t-else="" class="flex-grow-1 d-flex align-items-center justify-content-center text-muted p-4">
                        Select a chat to start messaging.
                    </div>
                </main>
            </t>

            <t t-else="">
                <div class="flex-grow-1 d-flex align-items-start justify-content-center overflow-auto p-4">
                    <ConnectWizard status="state.status" onStatus.bind="setStatus"/>
                </div>
            </t>
        </div>
    </t>
</templates>
